@model StudyPlanner.ViewModels.Subject.SubjectViewModel

@{
    ViewData["Title"] = "Delete Subject";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-body">
                <h3 class="text-danger">⚠️ Delete Subject</h3>
                <p class="text-muted">This action cannot be undone.</p>
                <hr />

                <dl class="row">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">Color</dt>
                    <dd class="col-sm-9">
                        <span style="display:inline-block; width:30px; height:20px; background-color:@Model.Color; border:1px solid #000; border-radius:4px;"></span>
                    </dd>
                </dl>

                @if (ViewData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">
                        @ViewData["ErrorMessage"]
                    </div>
                }

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
