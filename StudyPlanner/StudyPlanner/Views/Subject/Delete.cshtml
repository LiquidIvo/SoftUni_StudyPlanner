@model StudyPlanner.ViewModels.Subject.SubjectViewModel
@{
    ViewData["Title"] = "Delete Subject";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-danger shadow-sm">
            <div class="card-body">
                <h3 class="text-danger">⚠️ Delete Subject</h3>
                <p class="text-muted">This action cannot be undone.</p>

                @if (ViewData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">
                        @ViewData["ErrorMessage"]
                    </div>
                }

                <hr />
                <dl class="row">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">Color</dt>
                    <dd class="col-sm-9">
                        <span class="badge d-inline-block" style="background-color:@Model.Color; color:#fff; min-width: 60px; height: 30px;">
                            @Html.Raw("&nbsp;")
                        </span>
                    </dd>
                </dl>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>