@model StudyPlanner.ViewModels.Subject.SubjectInputModelBase

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Color" class="form-label"></label>
    <div class="d-flex align-items-center">
        <input asp-for="Color" type="color" class="form-control" style="width: 80px; height: 40px;" />
        <span class="ms-2 text-muted small">Pick a color</span>
    </div>
    <span asp-validation-for="Color" class="text-danger"></span>
</div>