@model StudyPlanner.ViewModels.StudySession.StudySessionCreateInputModel

<h1>Create Session</h1>

<form asp-action="Create">
    @await Html.PartialAsync("_StudySessionForm", Model)
    <div class="form-group mt-2">
        <input type="submit" value="Create" class="btn btn-primary" />
        <a asp-controller="StudyTask" asp-action="Details" asp-route-id="@Model.StudyTaskId" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

