@model StudyPlanner.ViewModels.StudySession.StudySessionViewModel

<h1>Delete Study Session</h1>
<h3>Are you sure you want to delete this session?</h3>

<dl class="row">

    <dt class="col-sm-3">Start Time</dt>
    <dd class="col-sm-9">@Model.StartTime</dd>

    <dt class="col-sm-3">End Time</dt>
    <dd class="col-sm-9">@Model.EndTime</dd>

    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">@Model.Notes</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-danger" /> |
    <a asp-controller="StudyTask" asp-action="Details" asp-route-id="@Model.StudyTaskId" class="btn btn-secondary">Back</a>
</form>
