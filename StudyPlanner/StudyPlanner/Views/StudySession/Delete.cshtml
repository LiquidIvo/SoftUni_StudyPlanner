@model StudyPlanner.ViewModels.StudySession.StudySessionViewModel
@{
    ViewData["Title"] = "Delete Study Session";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-danger shadow-sm">
            <div class="card-body">
                <h3 class="text-danger">⚠️ Delete Study Session</h3>
                <p class="text-muted">This action cannot be undone.</p>
                <hr />
                <dl class="row">
                    <dt class="col-sm-3">Start Time</dt>
                    <dd class="col-sm-9">@Model.StartTime.ToString("dd MMM yyyy HH:mm")</dd>

                    <dt class="col-sm-3">End Time</dt>
                    <dd class="col-sm-9">@Model.EndTime.ToString("dd MMM yyyy HH:mm")</dd>

                    <dt class="col-sm-3">Notes</dt>
                    <dd class="col-sm-9" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes" : Model.Notes)</dd>
                </dl>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-controller="StudyTask" asp-action="Details" asp-route-id="@Model.StudyTaskId" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>