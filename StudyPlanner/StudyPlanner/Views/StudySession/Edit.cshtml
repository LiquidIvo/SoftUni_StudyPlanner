@model StudyPlanner.ViewModels.StudySession.StudySessionEditInputModel

<h1>Edit Session</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    @await Html.PartialAsync("_StudySessionForm", Model)
    <div class="form-group mt-2">
        <input type="submit" value="Save Changes" class="btn btn-primary" />
        <a asp-controller="StudyTask" asp-action="Details" asp-route-id="@Model.StudyTaskId" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
