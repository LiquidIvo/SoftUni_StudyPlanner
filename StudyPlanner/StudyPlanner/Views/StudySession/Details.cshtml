@model StudyPlanner.ViewModels.StudySession.StudySessionViewModel

<h2>Study Session Notes</h2>

<div class="card">
    <div class="card-body">
        <p><strong>Start:</strong> @Model.StartTime</p>
        <p><strong>End:</strong> @Model.EndTime</p>

        <hr />

        <h5>Notes</h5>
        <p style="white-space: pre-wrap;">
            @(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes." : Model.Notes)
        </p>
    </div>
</div>

<a asp-controller="StudyTask"
   asp-action="Details"
   asp-route-id="@Model.StudyTaskId"
   class="btn btn-secondary mt-3">
    Back to task
</a>
