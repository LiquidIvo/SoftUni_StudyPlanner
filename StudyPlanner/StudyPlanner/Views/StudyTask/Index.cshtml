@using static StudyPlanner.GCommon.ApplicationConstants
@model IEnumerable<StudyPlanner.ViewModels.StudyTask.StudyTaskViewModel>
@{
    ViewData["Title"] = "Study Tasks";
}
<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">📚 Study Tasks</h3>
            <a asp-action="Create" class="btn btn-primary">
                + Create Task
            </a>
        </div>
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Due Date</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Category</th>
                    <th>Subject</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="max-width: 180px; word-wrap: break-word; overflow-wrap: break-word;">
                            <div style="max-height: 4.5em; overflow: hidden; white-space: normal;">@item.Title</div>
                        </td>
                        <td style="max-width: 300px; word-wrap: break-word; overflow-wrap: break-word;">
                            <div style="max-height: 4.5em; overflow: hidden; white-space: normal;">
                                @item.Description
                            </div>
                        </td>
                        <td>
                            @item.DueDate.ToString(DateFormatForStudyTask)
                        </td>
                        <td>
                            <span class="badge @(item.Priority == "High" ? "bg-danger" :
                                                        item.Priority == "Medium" ? "bg-warning text-dark" :
                                                        "bg-secondary")">
                                @item.Priority
                            </span>
                        </td>
                        <td>
                            <span class="badge @(item.Status == "Completed" ? "bg-success" :
                                                                 item.Status == "InProgress" ? "bg-info" :
                                                                 "bg-secondary")">
                                @item.Status
                            </span>
                        </td>
                        <td style="max-width: 120px;">
                            <span class="badge d-inline-block text-wrap" style="background-color:@item.CategoryColor; color:#fff; max-width: 100%;">
                                @item.Category
                            </span>
                        </td>
                        <td style="max-width: 120px;">
                            <span class="badge d-inline-block text-wrap" style="background-color:@item.SubjectColor; color:#fff; max-width: 100%;">
                                @item.Subject
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>