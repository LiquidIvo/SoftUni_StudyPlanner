@model StudyPlanner.ViewModels.StudyTask.StudyTaskViewModel
@{
    ViewData["Title"] = "Delete Task";
}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-danger shadow-sm">
            <div class="card-body">
                <h3 class="text-danger">⚠️ Delete Study Task</h3>
                <p class="text-muted">This action cannot be undone.</p>
                <hr />
                <dl class="row">
                    <dt class="col-sm-3">Title</dt>
                    <dd class="col-sm-9">@Model.Title</dd>
                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9" style="white-space: pre-wrap;">@Model.Description</dd>
                    <dt class="col-sm-3">Due Date</dt>
                    <dd class="col-sm-9">@Model.DueDate.ToString("dd MMM yyyy")</dd>
                    <dt class="col-sm-3">Priority</dt>
                    <dd class="col-sm-9">
                        <span class="badge @(Model.Priority == "High" ? "bg-danger" :
                                                     Model.Priority == "Medium" ? "bg-warning text-dark" :
                                                    "bg-secondary")">
                            @Model.Priority
                        </span>
                    </dd>
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        <span class="badge @(Model.Status == "Completed" ? "bg-success" :
                                                                          Model.Status == "InProgress" ? "bg-info" :
                                                                          "bg-secondary")">
                            @Model.Status
                        </span>
                    </dd>
                    <dt class="col-sm-3">Category</dt>
                    <dd class="col-sm-9">
                        <span class="badge d-inline-block text-wrap" style="background-color:@Model.CategoryColor; color:#fff; max-width: 100%;">
                            @Model.Category
                        </span>
                    </dd>
                    <dt class="col-sm-3">Subject</dt>
                    <dd class="col-sm-9">
                        <span class="badge d-inline-block text-wrap" style="background-color:@Model.SubjectColor; color:#fff; max-width: 100%;">
                            @Model.Subject
                        </span>
                    </dd>
                </dl>
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>