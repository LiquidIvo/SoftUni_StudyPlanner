@model StudyPlanner.ViewModels.StudyTask.StudyTaskDetailsViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Study Task Details</h1>

<div class="card mb-4">
    <div class="card-body">
        <h4>@Model.Title</h4>
        <dl class="row mt-3">

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9" style="white-space: pre-wrap;">@Model.Description</dd>

            <dt class="col-sm-3">Due Date</dt>
            <dd class="col-sm-9">@Model.DueDate.ToString("dd MMM yyyy")</dd>

            <dt class="col-sm-3">Priority</dt>
            <dd class="col-sm-9">
                <span class="badge
                    @(Model.Priority == "High" ? "bg-danger" :
                                            Model.Priority == "Medium" ? "bg-warning text-dark" :
                                            "bg-secondary")">
                    @Model.Priority
                </span>
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge
                    @(Model.Status == "Completed" ? "bg-success" :
                                            Model.Status == "InProgress" ? "bg-info" :
                                            "bg-secondary")">
                    @Model.Status
                </span>
            </dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">
                <span class="badge" style="background-color:@Model.CategoryColor; color:white;">
                    @Model.Category
                </span>
            </dd>

            <dt class="col-sm-3">Subject</dt>
            <dd class="col-sm-9">@Model.Subject</dd>
        </dl>

        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>

<h4>Study Sessions</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Notes</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.StudySessions != null && Model.StudySessions.Any())
        {
            foreach (var session in Model.StudySessions)
            {
                <tr>
                    <td>@session.StartTime.ToString("g")</td>
                    <td>@session.EndTime.ToString("g")</td>

                    
                    <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                        title="@session.Notes">
                        @session.Notes
                    </td>

                    <td class="text-nowrap">
                        <a asp-controller="StudySession" asp-action="Edit" asp-route-id="@session.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-controller="StudySession" asp-action="Delete" asp-route-id="@session.Id" class="btn btn-sm btn-danger">Delete</a>
                        <a asp-controller="StudySession" asp-action="Details" asp-route-id="@session.Id" class="btn btn-sm btn-info">Details</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4">No study sessions yet.</td>
            </tr>
        }
    </tbody>
</table>


<div class="mt-3">
    <a asp-controller="StudySession" asp-action="Create" asp-route-studyTaskId="@Model.Id" class="btn btn-success">
        + Add Study Session
    </a>
</div>
