@using StudyPlanner.ViewModels.Admin
@model IEnumerable<AdminUserViewModel>
@{
    ViewData["Title"] = "Manage Users";
    var searchTerm = ViewBag.SearchTerm as string;
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalCount = (int)ViewBag.TotalCount;
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">🛡️ Manage Users</h3>
            <span class="text-muted small">@totalCount user(s) found</span>
        </div>

        <form method="get" asp-area="Admin" asp-controller="Users" asp-action="Index" class="mb-3">
            <div class="input-group">
                <input type="text"
                       name="searchTerm"
                       value="@searchTerm"
                       class="form-control"
                       placeholder="Search by name or email..." />
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                           class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-1"></i>Clear
                    </a>
                }
            </div>
        </form>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        @if (!Model.Any())
        {
            <p class="text-muted text-center py-4">No users found.</p>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@(user.FullName ?? "—")</td>
                            <td>@user.Email</td>
                            <td class="text-end text-nowrap">
                                <a asp-area="Admin"
                                       asp-controller="Users"
                                       asp-action="Delete"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (totalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                                   asp-area="Admin"
                                   asp-controller="Users"
                                   asp-action="Index"
                                   asp-route-pageNumber="@(currentPage - 1)"
                                   asp-route-searchTerm="@searchTerm">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link"
                                       asp-area="Admin"
                                       asp-controller="Users"
                                       asp-action="Index"
                                       asp-route-pageNumber="@i"
                                       asp-route-searchTerm="@searchTerm">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link"
                                   asp-area="Admin"
                                   asp-controller="Users"
                                   asp-action="Index"
                                   asp-route-pageNumber="@(currentPage + 1)"
                                   asp-route-searchTerm="@searchTerm">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>
