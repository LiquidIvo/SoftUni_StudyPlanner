@{
    ViewData["Title"] = "Bad Request";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card shadow-sm border-secondary border-2">
            <div class="card-body py-5 px-4">

                <div class="display-1 fw-bold text-secondary mb-2">400</div>

                <div class="mb-3" style="font-size: 4rem; line-height: 1;">🚫</div>

                <h2 class="fw-bold mb-2">Bad Request</h2>
                <p class="text-muted mb-4">
                    The request could not be understood by the server.<br />
                    Please check your input and try again.
                </p>

                <hr class="my-4" />

                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-house-door me-1"></i> Go Home
                    </a>
                    <a asp-controller="StudyTask" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-list-task me-1"></i> My Tasks
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
