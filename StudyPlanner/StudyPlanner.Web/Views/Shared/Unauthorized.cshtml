@{
    ViewData["Title"] = "Unauthorized";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card shadow-sm border-danger border-2">
            <div class="card-body py-5 px-4">

                <div class="display-1 fw-bold text-danger mb-2">401</div>

                <div class="mb-3" style="font-size: 4rem; line-height: 1;">🔑</div>

                <h2 class="fw-bold mb-2">Unauthorized</h2>
                <p class="text-muted mb-4">
                    You need to be logged in to access this page.<br />
                    Please sign in and try again.
                </p>

                <hr class="my-4" />

                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-danger">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-danger">
                        <i class="bi bi-house-door me-1"></i> Go Home
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
