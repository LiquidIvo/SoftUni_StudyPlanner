@using static StudyPlanner.GCommon.ApplicationConstants
@model StudyPlanner.ViewModels.StudyTask.StudyTaskDetailsViewModel
@{
    ViewData["Title"] = "Task Details";
    var pageNumber = (int)(ViewData["PageNumber"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
}

<div class="row justify-content-center">
    <div class="col-md-10">

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">📋 @Model.Title</h3>
                    <a asp-action="DownloadPdf" asp-route-id="@Model.Id" class="btn btn-danger">
                        <i class="bi bi-file-pdf me-1"></i> Download PDF
                    </a>
                </div>
                <hr />
                <dl class="row">
                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9" style="white-space: pre-wrap;">@Model.Description</dd>

                    <dt class="col-sm-3">Due Date</dt>
                    <dd class="col-sm-9">@Model.DueDate.ToString(DateFormatForStudyTask)</dd>

                    <dt class="col-sm-3">Priority</dt>
                    <dd class="col-sm-9">
                        <span class="badge @(Model.Priority == "High" ? "bg-danger" :
                                                                                                       Model.Priority == "Medium" ? "bg-warning text-dark" :
                                                                                                       "bg-secondary")">
                            @Model.Priority
                        </span>
                    </dd>

                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        <span class="badge @(Model.Status == "Completed"  ? "bg-success" :
                                                                                                       Model.Status == "InProgress" ? "bg-info" :
                                                                                                       "bg-secondary")">
                            @Model.Status
                        </span>
                    </dd>

                    <dt class="col-sm-3">Category</dt>
                    <dd class="col-sm-9">
                        <span class="badge d-inline-block text-wrap"
                              style="background-color:@Model.CategoryColor; color:white; max-width:100%;">
                            @Model.Category
                        </span>
                    </dd>

                    <dt class="col-sm-3">Subject</dt>
                    <dd class="col-sm-9">
                        <span class="badge d-inline-block text-wrap"
                              style="background-color:@Model.SubjectColor; color:white; max-width:100%;">
                            @Model.Subject
                        </span>
                    </dd>
                </dl>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        ← Back to List
                    </a>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            Edit Task
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                            Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">⏱️ Study Sessions</h4>
                    <a asp-controller="StudySession" asp-action="Create"
                           asp-route-studyTaskId="@Model.Id" class="btn btn-success">
                        + Add Session
                    </a>
                </div>

                @if (Model.StudySessions != null && Model.StudySessions.Any())
                {
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Duration</th>
                                <th>Notes</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in Model.StudySessions)
                            {
                                <tr>
                                    <td>@session.StartTime.ToString(DateFormatForStudySession)</td>
                                    <td>@session.EndTime.ToString(DateFormatForStudySession)</td>
                                    <td>
                                        <span class="badge bg-info">
                                            @((session.EndTime - session.StartTime).TotalMinutes.ToString("0")) min
                                        </span>
                                    </td>
                                    <td style="max-width:250px;">
                                        <div style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                             title="@session.Notes">
                                            @(string.IsNullOrWhiteSpace(session.Notes) ? "No notes" : session.Notes)
                                        </div>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a asp-controller="StudySession" asp-action="Details"
                                           asp-route-id="@session.Id"
                                           class="btn btn-sm btn-outline-primary">Details</a>
                                        <a asp-controller="StudySession" asp-action="Edit"
                                           asp-route-id="@session.Id"
                                           class="btn btn-sm btn-outline-secondary">Edit</a>
                                        <a asp-controller="StudySession" asp-action="Delete"
                                           asp-route-id="@session.Id"
                                           class="btn btn-sm btn-outline-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (totalPages > 1)
                    {
                        <div class="d-flex justify-content-center align-items-center gap-3 mt-3">
                            <a class="btn btn-outline-secondary btn-sm @(pageNumber == 1 ? "disabled" : "")"
                                   asp-action="Details"
                                   asp-route-id="@Model.Id"
                                   asp-route-pageNumber="@(pageNumber - 1)">
                                ← Prev
                            </a>
                            <span class="text-muted small">Page @pageNumber of @totalPages</span>
                            <a class="btn btn-outline-secondary btn-sm @(pageNumber == totalPages ? "disabled" : "")"
                                   asp-action="Details"
                                   asp-route-id="@Model.Id"
                                   asp-route-pageNumber="@(pageNumber + 1)">
                                Next →
                            </a>
                        </div>
                    }

                    <div class="mt-3 p-3 bg-light rounded">
                        <strong>Total Study Time Of The Current Page:</strong>
                        <span class="badge bg-primary ms-2">
                            @{
                                var totalMinutes = Model.StudySessions.Sum(s => (s.EndTime - s.StartTime).TotalMinutes);
                                var hours = (int)(totalMinutes / 60);
                                var minutes = (int)(totalMinutes % 60);
                            }
                            @hours h @minutes min
                        </span>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        No study sessions yet. Click "Add Session" to start tracking your study time!
                    </div>
                }
            </div>
        </div>
    </div>
</div>