@using StudyPlanner.ViewModels.Subject
@model IEnumerable<SubjectViewModel>
@{
    ViewData["Title"] = "Subjects";
    var searchTerm = ViewData["SearchTerm"] as string;
    var pageNumber = (int)(ViewData["PageNumber"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">📚 Subjects</h3>
            <a asp-action="Create" class="btn btn-primary">
                + Create Subject
            </a>
        </div>

        <form asp-action="Index" method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="searchTerm"
                       value="@searchTerm"
                       class="form-control"
                       placeholder="Search by name..." />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-1"></i> Search
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x"></i> Clear
                </a>
            </div>
        </form>

        @if (!Model.Any())
        {
            <p class="text-muted text-center py-4">No subjects found.</p>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Color</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>
                                <span class="badge d-inline-block"
                                      style="background-color:@item.Color; color:#fff; min-width:80px; height:30px;">
                                    &nbsp;
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-center align-items-center gap-3 mt-3">
                    <a class="btn btn-outline-secondary btn-sm @(pageNumber == 1 ? "disabled" : "")"
                           asp-action="Index"
                           asp-route-pageNumber="@(pageNumber - 1)"
                           asp-route-searchTerm="@searchTerm">
                        ← Prev
                    </a>
                    <span class="text-muted small">Page @pageNumber of @totalPages</span>
                    <a class="btn btn-outline-secondary btn-sm @(pageNumber == totalPages ? "disabled" : "")"
                           asp-action="Index"
                           asp-route-pageNumber="@(pageNumber + 1)"
                           asp-route-searchTerm="@searchTerm">
                        Next →
                    </a>
                </div>
            }
        }
    </div>
</div>