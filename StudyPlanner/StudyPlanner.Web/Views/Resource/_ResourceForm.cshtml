@using StudyPlanner.ViewModels.Resource
@model ResourceInputModelBase

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" placeholder="e.g. MDN Web Docs" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Url" class="form-label"></label>
    <input asp-for="Url" class="form-control" placeholder="https://..." />
    <span asp-validation-for="Url" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"
              placeholder="Optional short description..."></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
